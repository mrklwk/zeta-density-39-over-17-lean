  have hr := Nat.mod_lt M hk
  have he := Nat.mod_add_div M K
  have hq : 1 ≤ M/K := (Nat.le_div_iff_mul_le hk).mpr (by simpa using hM)
  constructor
  · omega
  constructor
  · have hmul : 3*(M/K) ≤ M := by nlinarith
    omega
  constructor
  · nlinarith
  · nlinarith

