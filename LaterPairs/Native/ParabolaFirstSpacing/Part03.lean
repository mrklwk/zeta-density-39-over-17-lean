private theorem bourgainShiftSixMoment_dilate {ι : Type*}
    (S : Finset ι) (z : ι → ℂ) (w : ι → ℝ) (δ : ℝ) {c : ℝ} (hc : c≠0)
    (x : Fin 4 → ℝ) :
