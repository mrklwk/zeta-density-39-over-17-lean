        (![c,c^2,c^3,c^4] : Fin 4 → ℝ) i≤1 := by
    fin_cases i
    · change (1/16:ℝ)≤c ∧ c≤1
      exact ⟨by linarith [hc.1],hc.2⟩
    · change (1/16:ℝ)≤c^2 ∧ c^2≤1
      have hh := hp 2
      norm_num only [show (1/2:ℝ)^2=1/4 by norm_num] at hh
      exact ⟨by linarith [hh.1],hh.2⟩
    · change (1/16:ℝ)≤c^3 ∧ c^3≤1
      have hh := hp 3
