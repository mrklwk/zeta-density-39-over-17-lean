      rw [←he]
      exact norm_sum_le _ _
    have hpower := pow_le_pow_left₀ (norm_nonneg _) hnorm 12
    have hholder := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg J
      (f:=fun j => ‖∑ i∈U j,f i‖) (p:=(12:ℝ)) (by norm_num)
