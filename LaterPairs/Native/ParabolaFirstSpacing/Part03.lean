    (∫ x : Fin 4 → ℝ in Icc (fun _ => -1) (fun _ => 1), (F S x)^2) ≤
      (4096*7^12:ℝ)*(∑ j∈J,∫ x : Fin 4 → ℝ in Icc (fun _ => -1) (fun _ => 1),(F (U j) x)^2)+
      4096*(J.card:ℝ)^11*(∑ i∈J,∑ j∈J.filter (fun j => 3 < |i-j|),
        ∫ x : Fin 4 → ℝ in Icc (fun _ => -1) (fun _ => 1),F (U j) x*F (U i) x) := by
  classical
  dsimp only
  let J := S.image g
