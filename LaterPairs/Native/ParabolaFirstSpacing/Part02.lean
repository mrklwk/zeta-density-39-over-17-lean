private theorem exists_bourgain_quadratic_weighted_cube {ε : ℝ} (hε : 0<ε) :
    ∃ C>(0:ℝ), ∀ (Q : ℕ), 1≤Q → ∀ (z : Fin Q → ℂ) (B : ℝ), 0≤B →
      (∀ n, ‖z n‖≤B) →
      (∫ α : Fin 2 → ℝ in {α | ∀ j, α j∈Ioc (0:ℝ) 1},
        ‖∑ n : Fin Q, z n*fordAdditiveCharacter
