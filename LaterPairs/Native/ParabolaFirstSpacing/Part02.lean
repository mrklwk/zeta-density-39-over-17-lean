public  theorem bourgain_integer_dilation_fiber_mass {ι : Type*}
    (S : Finset ι) (z : ι → ℂ) (m : ι → ℤ) {B : ℝ} (hB : 0≤B)
    (hm : ∀ q : ℤ,(∑ i∈S.filter (fun i => m i=q),‖z i‖)≤B)
