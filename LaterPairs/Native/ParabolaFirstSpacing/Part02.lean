    Real.sqrt_sq (bourgainShiftRoot_range hδ.1 (ht j i hi)).1
  have ha j i (hi : i∈V j) : Real.sqrt (a j i)=bourgainShiftRoot δ (v j i) :=
    Real.sqrt_sq (bourgainShiftRoot_range hδ.1 (hv j i hi)).1
