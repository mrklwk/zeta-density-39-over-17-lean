  intro i hi
  have he : (m i:ℝ)*u+(v+1)*(m i:ℝ)^2 =
      ((m i:ℝ)*u+v*(m i:ℝ)^2)+((m i)^2:ℤ) := by push_cast; ring
  rw [he,fordAdditiveCharacter_add,hchar,mul_one]

