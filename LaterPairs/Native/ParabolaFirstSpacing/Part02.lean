private theorem bourgain_integer_phase_periodic_average {ι : Type*}
    (S : Finset ι) (z : ι → ℂ) (m : ι → ℤ) (a : ι → ℝ)
    {T K : ℝ} (hT : 0<T) (hTK : T≤K) :
