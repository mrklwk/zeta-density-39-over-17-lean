      _ = (3*Real.pi*K*D*J)*(B γ*(1+|γ*h^2|)^12) := by ring
      _ ≤ (3*Real.pi*K*D*J)*L γ := h₃
      _ = _ := by ring
  have hright : Integrable (fun γ : ℝ => (3*Real.pi*K*D)*L γ*J) :=
    (hiL.const_mul _).mul_const _
