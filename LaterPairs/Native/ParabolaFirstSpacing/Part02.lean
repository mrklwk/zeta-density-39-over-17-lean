      simp only [smul_eq_mul,fordAdditiveCharacter]
      have he : (↑(-2*Real.pi*ξ*(-t)) : ℂ)*Complex.I =
          2*(Real.pi:ℂ)*Complex.I*↑(ξ*t) := by push_cast; ring
      rw [he]
