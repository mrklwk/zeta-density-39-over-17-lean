  have hf₀ (y : ℝ) : 0≤f y := integral_nonneg (fun u => by positivity)
  have hg₀ (y : ℝ) : 0≤g y := integral_nonneg (fun u => by positivity)
  have hQ₀ (x : Fin 2 → ℝ) : 0≤Q x := integral_nonneg (fun u =>
