        ∫ y : Fin 4 → ℝ in Icc (fun _ => -K) (fun _ => K), f (q+y) := by
  convert bourgain_anisotropic_rectangle_average (fun _ => K) (fun _ => hK) Q f hfc hf₀ using 1
  simp only [Finset.prod_const,Finset.card_univ,Fintype.card_fin]

