    (S : Finset ι) (z : ι → ℂ) (m : ι → ℤ)
    (s : ι → ℝ) {T δ c : ℝ} (hT : 0<T)
    (hm : ∀ i∈S,T*δ*s i=(m i:ℝ)-c) :
    (∫ y : ℝ in Icc (-4*T^2) (4*T^2), ∫ u : ℝ in Icc (0:ℝ) 1,
