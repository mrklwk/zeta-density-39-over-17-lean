    (S : Finset ι) (z : ι → ℂ) (m : ι → ℤ) (w : ι → ℝ) (δ : ℝ)
    {T : ℝ} (hT : T≠0) (hw : ∀ i∈S, T*w i=(m i:ℝ))
    (x : Fin 3 → ℝ) (r : ℝ) :
    (∫ u : ℝ in Icc (0:ℝ) 1,
      bourgainShiftSixMoment S z w δ ![T*u+r,x 0,x 1,x 2]) =
    (∫ u : ℝ in Icc (0:ℝ) 1,
