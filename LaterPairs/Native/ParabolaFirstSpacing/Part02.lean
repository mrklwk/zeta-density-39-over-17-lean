  let F := fun x : ℝ => ‖∑ i∈S, z i*fordAdditiveCharacter (x*((m i:ℝ)/T)+a i)‖^6
  let G := fun u : ℝ => ‖∑ i∈S, z i*fordAdditiveCharacter (u*(m i:ℝ)+a i)‖^6
