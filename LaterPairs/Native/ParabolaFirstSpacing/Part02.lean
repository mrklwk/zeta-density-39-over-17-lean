    ‖∑ n : Fin Q,z n*fordVinogradovMonomial n α‖^6
      ∂Measure.pi (fun _ : Fin 2 => AddCircle.haarAddCircle)) ≤ _ at hm
  rw [hpre] at hm
  calc
    _ ≤ B^6*(fordVinogradovMomentNat 3 2 Q:ℝ) := hm
    _ ≤ B^6*(C*(Q:ℝ)^((3:ℝ)+ε)) :=
      mul_le_mul_of_nonneg_left (hcount Q hQ) (pow_nonneg hB 6)
    _ = _ := by ring

