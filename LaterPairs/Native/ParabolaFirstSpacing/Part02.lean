  have he (y : ℝ) :
      (∫ u : ℝ in Icc (0:ℝ) 1,
        ‖∑ i∈S,z i*fordAdditiveCharacter ((m i:ℝ)*u+δ^2*y*(s i)^2)‖^6) =
