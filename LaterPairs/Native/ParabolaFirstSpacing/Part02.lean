private theorem bourgain_integer_quadratic_period_continuous {ι : Type u}
    (S : Finset ι) (z : ι → ℂ) (m : ι → ℤ) :
    Continuous (fun v : ℝ => ∫ u : ℝ in Icc (0:ℝ) 1,
      ‖∑ i∈S,z i*fordAdditiveCharacter ((m i:ℝ)*u+v*(m i:ℝ)^2)‖^6) := by
